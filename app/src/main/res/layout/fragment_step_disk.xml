<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3：磁盘与镜像 -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 虚拟硬盘大小 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="虚拟硬盘"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekDisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="32"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDiskSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vm_disk_gb"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- ISO 引导镜像 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/iso_path"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvIsoPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_iso"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="12dp"
            android:background="@color/surface_variant"
            android:layout_marginBottom="8dp"
            android:singleLine="true"
            android:ellipsize="middle" />

        <Button
            android:id="@+id/btnSelectIso"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_iso"
            android:layout_marginBottom="16dp" />

        <!-- 签名认证提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ 开启签名认证后，系统将校验 ISO 的 SHA-256 哈希值"
            android:textColor="@color/md_theme_error"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
